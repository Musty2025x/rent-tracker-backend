# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Get this from https://neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/renttracker?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_at_least_64_chars  # openssl rand -hex 32
JWT_EXPIRES_IN=7d

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── Email reminders (Resend) ─────────────────────────────────────────────────
# Get free API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
REMINDER_FROM_EMAIL=reminders@yourdomain.com
REMINDER_TO_EMAIL=you@youremail.com

# ─── SMS reminders (Termii — Nigerian SMS) ────────────────────────────────────
# Get API key at https://termii.com
TERMII_API_KEY=TLxxxxxxxxxxxxxxxxxxxxxxxxxx
TERMII_SENDER_ID=RentTrack
# Your phone number to receive SMS alerts e.g. +2348012345678
REMINDER_PHONE=+2348012345678
